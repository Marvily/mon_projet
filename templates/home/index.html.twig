{% extends 'base.html.twig' %}

{% block title %}🍽️ Mes Recettes{% endblock %}

{% block body %}
<style>
      body {
            font-family: Arial;
            margin: 0;
            background: #f5f5f5;
        }

        header {
            background: #ff6b6b;
            color: white;
            padding: 20px;
            text-align: center;
        }

        .container {
            padding: 30px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }

        .card {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            transition: transform 0.2s;
        }

        .card:hover {
            transform: scale(1.03);
        }

        .card img {
            width: 100%;
            height: 150px;
            object-fit: cover;
        }

        .card-content {
            padding: 15px;
        }

        .card h3 {
            margin: 0 0 10px;
        }

        .card p {
            color: #666;
        }

.btn-login {
    display: inline-block;
    margin-top: 10px;
    padding: 10px 20px;
    background: white;
    color: #ff6b6b;
    border-radius: 20px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.2s;
}

.btn-login:hover {
    background: #ffe0e0;
}

</style>

{% if not app.user %}
    <a href="{{ path('app_login') }}" class="btn-login">Se connecter</a>
{% else %}
    <span>Bonjour {{ app.user.userIdentifier }}</span>
{% endif %}

    <p>Découvrez des idées de plats délicieux</p>
<div class="container" >
    <div class="grid">
        {% for recipe in recipes %}
            <div class="card">
                <img src="{{ recipe.image }}" alt="">
                <div class="card-content">
                    <h3>{{ recipe.title }}</h3>
                    <p>{{ recipe.description }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
